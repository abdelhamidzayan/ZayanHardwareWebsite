{
    "name": "zayan/hardware",
    "description": "Zayan Hardware - mobile hardware repair community",
    "type": "project",
    "require": {
        "php": ">=8.2",
        "ext-pdo": "*",
        "ext-mbstring": "*",
        "minishlink/web-push": "^9.0"
    },
    "autoload": {
        "psr-4": {
            "App\\Core\\": "app/core/",
            "App\\Controllers\\": "app/controllers/",
            "App\\Models\\": "app/models/",
            "App\\Services\\": "app/services/",
            "App\\Middleware\\": "app/middleware/"
        }
    },
    "config": {
        "optimize-autoloader": true
    }
}
