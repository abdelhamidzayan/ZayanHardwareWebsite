# The public directory is the only web entry point.
Options -Indexes -MultiViews
DirectoryIndex index.php

<FilesMatch "^\.">
    Require all denied
</FilesMatch>

RewriteEngine On

# Serve real public assets directly; send application routes to the front controller.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

RewriteRule ^ index.php [L,QSA]
